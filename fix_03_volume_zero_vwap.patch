diff --git a/vwap_support_resistance_pattern.py b/vwap_support_resistance_pattern.py
--- a/vwap_support_resistance_pattern.py
+++ b/vwap_support_resistance_pattern.py
@@ -106,7 +106,12 @@
     for session_date, day_df in df.groupby("_date"):
         day_df = day_df.sort_index()
